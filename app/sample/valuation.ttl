@prefix :     <http://example.org/valuation#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/valuation> a owl:Ontology ;
    rdfs:label "Valuation ontology (sample)"@en .

#################################################################
#  Classes
#################################################################

:Client a owl:Class ;
    rdfs:label "Client"@en ;
    rdfs:comment "The party that commissions a valuation."@en .

:ValuationProcess a owl:Class ;
    rdfs:label "Valuation process"@en ;
    rdfs:comment "One valuation exercise for a portfolio company at a valuation date."@en .

:PortfolioCompany a owl:Class ;
    rdfs:label "Portfolio company"@en .

:CurrentFinancials a owl:Class ;
    rdfs:label "Current financials"@en ;
    rdfs:comment "Latest reported financial figures for a portfolio company."@en .

:ValuationMethods a owl:Class ;
    rdfs:label "Valuation methods"@en .

:DCF a owl:Class ;
    rdfs:subClassOf :ValuationMethods ;
    rdfs:label "Discounted cash flow"@en .

:GCP a owl:Class ;
    rdfs:subClassOf :ValuationMethods ;
    rdfs:label "Guideline public companies"@en .

:GT a owl:Class ;
    rdfs:subClassOf :ValuationMethods ;
    rdfs:label "Guideline transactions"@en .

:Backsolve a owl:Class ;
    rdfs:subClassOf :ValuationMethods ;
    rdfs:label "Backsolve"@en .

:PostMoney a owl:Class ;
    rdfs:subClassOf :ValuationMethods ;
    rdfs:label "Post-money"@en .

:User a owl:Class ;
    rdfs:label "User"@en .

#################################################################
#  Object properties
#################################################################

:initiates a owl:ObjectProperty ;
    rdfs:domain :Client ; rdfs:range :ValuationProcess ;
    rdfs:label "initiates"@en .

:hasValuation a owl:ObjectProperty ;
    rdfs:domain :PortfolioCompany ; rdfs:range :ValuationProcess ;
    rdfs:label "has valuation"@en .

:hasCurrentFinancials a owl:ObjectProperty ;
    rdfs:domain :PortfolioCompany ; rdfs:range :CurrentFinancials ;
    rdfs:label "has current financials"@en .

:hasMethodology a owl:ObjectProperty ;
    rdfs:domain :ValuationProcess ; rdfs:range :ValuationMethods ;
    rdfs:label "has methodology"@en .

# Inverses: the reasoner adds the reverse link automatically
:valuationOf a owl:ObjectProperty ;
    owl:inverseOf :hasValuation ;
    rdfs:label "valuation of"@en .

:initiatedBy a owl:ObjectProperty ;
    owl:inverseOf :initiates ;
    rdfs:label "initiated by"@en .

:methodologyOf a owl:ObjectProperty ;
    owl:inverseOf :hasMethodology ;
    rdfs:label "methodology of"@en .

#################################################################
#  Axioms the reasoner checks
#################################################################

:Client owl:disjointWith :PortfolioCompany .

[] a owl:AllDisjointClasses ;
   owl:members ( :DCF :GCP :GT :Backsolve :PostMoney ) .

#################################################################
#  Datatype properties
#################################################################

:clientName a owl:DatatypeProperty ;
    rdfs:domain :Client ; rdfs:range xsd:string ; rdfs:label "client name"@en .

:name a owl:DatatypeProperty ;
    rdfs:domain :PortfolioCompany ; rdfs:range xsd:string ; rdfs:label "name"@en .

:sector a owl:DatatypeProperty ;
    rdfs:domain :PortfolioCompany ; rdfs:range xsd:string ; rdfs:label "sector"@en .

:AcquisitionDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :PortfolioCompany ; rdfs:range xsd:date ; rdfs:label "acquisition date"@en .

:valuationDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :ValuationProcess ; rdfs:range xsd:date ; rdfs:label "valuation date"@en .

:valuationPurpose a owl:DatatypeProperty ;
    rdfs:domain :ValuationProcess ; rdfs:range xsd:string ; rdfs:label "valuation purpose"@en .

:fiscalYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :CurrentFinancials ; rdfs:range xsd:gYear ; rdfs:label "fiscal year"@en .

:revenue a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :CurrentFinancials ; rdfs:range xsd:decimal ; rdfs:label "revenue"@en .

:ebitda a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :CurrentFinancials ; rdfs:range xsd:decimal ; rdfs:label "EBITDA"@en .

:netDebt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :CurrentFinancials ; rdfs:range xsd:decimal ; rdfs:label "net debt"@en .

:discountRate a owl:DatatypeProperty ;
    rdfs:domain :DCF ; rdfs:range xsd:decimal ; rdfs:label "discount rate"@en .

:terminalGrowthRate a owl:DatatypeProperty ;
    rdfs:domain :DCF ; rdfs:range xsd:decimal ; rdfs:label "terminal growth rate"@en .

:evRevenueMultiple a owl:DatatypeProperty ;
    rdfs:domain :GCP ; rdfs:range xsd:decimal ; rdfs:label "EV / revenue multiple"@en .

:transactionMultiple a owl:DatatypeProperty ;
    rdfs:domain :GT ; rdfs:range xsd:decimal ; rdfs:label "transaction multiple"@en .

:roundPricePerShare a owl:DatatypeProperty ;
    rdfs:domain :Backsolve ; rdfs:range xsd:decimal ; rdfs:label "round price per share"@en .

:postMoneyValuation a owl:DatatypeProperty ;
    rdfs:domain :PostMoney ; rdfs:range xsd:decimal ; rdfs:label "post-money valuation"@en .

:userId a owl:DatatypeProperty ;
    rdfs:domain :User ; rdfs:range xsd:string ; rdfs:label "user id"@en .

#################################################################
#  Annotation properties (provenance)
#################################################################

:userEdited a owl:AnnotationProperty ;
    rdfs:label "user edited"@en ;
    rdfs:comment "Datatype properties on this individual whose values were entered or edited by a user."@en .

:editedBy a owl:AnnotationProperty ;
    rdfs:label "edited by"@en .

:editedAt a owl:AnnotationProperty ;
    rdfs:label "edited at"@en .
