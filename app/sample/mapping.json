{
  "version": 1,
  "settings": {
    "dataNamespace": "http://example.org/valuation#",
    "userEditedIri": "http://example.org/valuation#userEdited",
    "provenance": {
      "pattern": "axiom-text",
      "editedBy": {
        "mode": "column",
        "value": "entered_by"
      },
      "editedAt": {
        "mode": "column",
        "value": "entered_at"
      }
    },
    "steps": [
      {
        "name": "Derive EBITDA margin",
        "enabled": true,
        "sparql": "# EBITDA / revenue, for financials that have both and no margin yet\nINSERT { ?f :ebitdaMargin ?margin }\nWHERE {\n  ?f a :CurrentFinancials ; :ebitda ?e ; :revenue ?r .\n  FILTER(?r != 0)\n  FILTER NOT EXISTS { ?f :ebitdaMargin ?any }\n  BIND(ROUND(?e / ?r * 10000) / 10000 AS ?margin)\n}"
      }
    ],
    "reasoner": {
      "auto": false,
      "profile": "owlrl"
    },
    "validation": {
      "auto": true,
      "withInferences": false
    },
    "queries": [
      {
        "name": "dcf-user-inputs",
        "description": "DCF inputs entered by users, with company, user and time",
        "sparql": "SELECT ?company ?dcf ?field ?value ?editedBy ?editedAt WHERE {\n  ?dcf a :DCF ;\n       :userEdited ?field ;\n       ?field ?value .\n  OPTIONAL {\n    ?ax owl:annotatedSource ?dcf ;\n        owl:annotatedProperty :userEdited ;\n        owl:annotatedTarget ?field ;\n        :editedBy ?editedBy ;\n        :editedAt ?editedAt .\n  }\n  OPTIONAL { ?v :hasMethodology ?dcf . ?c :hasValuation ?v ; :name ?company . }\n}\nORDER BY ?company ?field"
      },
      {
        "name": "company-financials",
        "description": "Latest financials per company",
        "sparql": "SELECT ?company ?fiscalYear ?revenue ?ebitda ?margin WHERE {\n  ?c a :PortfolioCompany ; :name ?company ; :hasCurrentFinancials ?f .\n  ?f :fiscalYear ?fiscalYear ; :revenue ?revenue .\n  OPTIONAL { ?f :ebitda ?ebitda }\n  OPTIONAL { ?f :ebitdaMargin ?margin }\n}\nORDER BY ?company ?fiscalYear"
      }
    ]
  },
  "nodes": [
    {
      "id": "client",
      "label": "Client",
      "classIri": "http://example.org/valuation#Client",
      "scope": "row",
      "requireData": true,
      "naming": {
        "mode": "hybrid",
        "prefix": "Client_",
        "pad": 0,
        "template": "{client_name|pascal}",
        "list": "Harbour Point Capital => HPC_Client\nMarlow Ridge Partners => MarlowRidge_Client",
        "listMatch": "key",
        "listKey": "client_name",
        "onMissing": "auto",
        "collision": "merge"
      },
      "props": [
        {
          "id": "client_p1",
          "propIri": "http://example.org/valuation#clientName",
          "source": "column",
          "column": "client_name",
          "constant": "",
